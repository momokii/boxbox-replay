# .env.example — Committed template of required environment variables.
# Copy to `.env` for local development and fill in real values there.
# RULE: every new variable MUST be added here with a placeholder value and a
# description comment. NEVER put real secrets in this file.

# Application environment. Allowed values: development | staging | production
APP_ENV=development

# Port the application listens on (example placeholder).
APP_PORT=3000

# Log verbosity. Example values: debug | info | warn | error
LOG_LEVEL=info

# Database connection string (placeholder — use a local/dev database here).
DATABASE_URL=postgresql://user:password@localhost:5432/app_dev

# Secret for signing sessions/tokens (placeholder — generate a random one in .env).
APP_SECRET=change-me-generate-a-random-value-locally
