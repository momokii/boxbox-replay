# .env.example — Committed template of required environment variables.
# Copy to `.env` for local development (`./scripts/setup.sh` does this for you).
# RULE: every new variable MUST be added here with a placeholder value and a
# description comment. NEVER put real secrets in this file.

# Application environment. Allowed values: development | staging | production
APP_ENV=development

# Port the Streamlit app listens on (host mapping in compose.yaml).
APP_PORT=8501

# OpenF1 API base URL. Override only to pin/mirror.
OPENF1_BASE_URL=https://api.openf1.org/v1

# OpenF1 request budget. The free tier allows 3 req/s and 30 req/min per IP;
# raise both only on the sponsor tier (6 / 60) or your own mirror.
OPENF1_RATE_PER_SEC=3
OPENF1_RATE_PER_MIN=30

# OpenF1 credential (placeholder — leave empty unless the feed asks for one).
# When set, it is sent as both a Bearer token and an api_key parameter.
OPENF1_API_KEY=

# Parquet cache directory (container path; dev bind-mounts ./data).
CACHE_DIR=/app/data/cache

# Log verbosity. Example values: debug | info | warn | error
LOG_LEVEL=info

# Model override for the legacy `opencode run` coach. Empty = opencode default.
BOXBOX_MODEL=

# ── AI answers (OpenCode Go, OpenAI-compatible) ──────────────────────────────
# Get a key from https://opencode.ai/ (Go plan). NEVER commit a real key: this
# file is the committed template, `.env` is gitignored.
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_API_KEY=
# Confirmed working with the Go plan on 2026-11-03.
OPENCODE_MODEL=deepseek-v4.1-flash
# Server-side budget and answer length: protects the subscription.
AI_MAX_TOKENS=500
AI_RATE_PER_MIN=6
AI_TIMEOUT_S=60
